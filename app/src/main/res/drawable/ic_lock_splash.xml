<?xml version="1.0" encoding="utf-8"?>
<!-- Open-state padlock. The "shackle" group starts rotated open; the AVD
     animates it shut (rotation -30 -> 0, drops into the body). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <group
        android:name="shackle"
        android:pivotX="16"
        android:pivotY="26"
        android:rotation="-30"
        android:translateY="-3">
        <path
            android:name="shackle_path"
            android:strokeColor="#FF94A3B8"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M16,26 L16,18 A8,8 0 0 1 32,18 L32,22" />
    </group>

    <path
        android:name="body"
        android:fillColor="#FF1E293B"
        android:pathData="M10,24 h28 a3,3 0 0 1 3,3 v11 a3,3 0 0 1 -3,3 H10 a3,3 0 0 1 -3,-3 V27 a3,3 0 0 1 3,-3 Z" />

    <path
        android:name="keyhole"
        android:fillColor="#FF090D16"
        android:pathData="M24,30 m-2.6,0 a2.6,2.6 0 1 1 5.2,0 a2.6,2.6 0 1 1 -5.2,0 Z M22.7,32 h2.6 l1,6 h-4.6 Z" />
</vector>
